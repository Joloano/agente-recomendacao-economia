# Servidor da interface. ${API_UPSTREAM} é substituído ao subir o container.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 5m;

    # Cabeçalhos de segurança em nginx-seguranca.conf (o proxy da VPS pode reforçá-los, #63).
    include /etc/nginx/snippets/seguranca.conf;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Liveness do próprio nginx (não depende da API).
    location = /saude {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API: mesma origem para o navegador, sem CORS.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Arquivos com hash no nome: cache longo e imutável.
    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpg|jpeg|gif|ico|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        include /etc/nginx/snippets/seguranca.conf;
        try_files $uri =404;
    }

    # SPA: rotas do Angular caem no index.html, que nunca é cacheado.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/seguranca.conf;
    }
}

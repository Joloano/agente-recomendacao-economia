# Copie para .env e ajuste os valores. Nunca commite o .env.

# --- Aplicação ---
AMBIENTE=dev                     # dev | teste | staging | producao
NOME_APP="Agente Recomendador de Energia e Água"
LOG_NIVEL=INFO
CORS_ORIGENS=http://localhost:4200   # várias: separe por vírgula; nunca use *

# --- Banco de dados (PostgreSQL) ---
POSTGRES_HOST=db
POSTGRES_PORTA=5432
POSTGRES_DB=agente
POSTGRES_USUARIO=agente
POSTGRES_SENHA=troque-esta-senha
POSTGRES_TIMEOUT_CONEXAO_S=5

# --- Segurança (JWT) ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SEGREDO=troque-por-um-segredo-longo-e-aleatorio
JWT_ALGORITMO=HS256
JWT_EXPIRACAO_MINUTOS=30
JWT_REFRESH_EXPIRACAO_DIAS=7

# --- Administrador inicial (criado pelo seed) ---
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=troque-esta-senha-forte

# --- E-mail ---
EMAIL_REMETENTE=nao-responda@exemplo.com
SMTP_HOST=mailpit
SMTP_PORTA=1025
SMTP_USUARIO=
SMTP_SENHA=
SMTP_TLS=false

# --- Frontend ---
URL_FRONTEND=http://localhost:4200

# --- Container da API (lidas pelo docker-entrypoint.sh) ---
MIGRAR_AO_SUBIR=true             # réplicas podem migrar juntas: um advisory lock serializa
WORKERS=2                        # processos do Uvicorn
PORTA=8000
IPS_PROXY_CONFIAVEIS=127.0.0.1   # IP/CIDR do proxy reverso; nunca * com a porta exposta
TEMPO_DESLIGAMENTO_S=30          # tempo máximo para concluir requisições ao parar

# --- Portas publicadas pelo docker compose ---
PORTA_WEB=4200                   # interface (e /api por meio do nginx)
PORTA_API=8000                   # só no desenvolvimento (override)
PORTA_DB=55432                   # só no desenvolvimento; 5432 costuma estar reservada no Windows
